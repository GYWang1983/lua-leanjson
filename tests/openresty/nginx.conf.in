worker_processes 1;
daemon off;
master_process on;
pid @PREFIX@/nginx.pid;
error_log @PREFIX@/error.log info;
env LD_LIBRARY_PATH;
env QJSON_TEST_PREFIX;
env QJSON_TEST_PORT;
env QJSON_SINK_PORT;
events { worker_connections 1024; }
http {
    access_log off;
    lua_package_path '@ROOT@/lua/?.lua;@ROOT@/examples/openresty/?.lua;@ROOT@/tests/openresty/?.lua;/usr/local/share/lua/5.1/?.lua;/usr/local/share/lua/5.1/?/init.lua;;';
    lua_check_client_abort on;
    client_max_body_size 256m;
    client_body_buffer_size 64k;
    client_body_temp_path @PREFIX@/client-body;
    client_body_timeout 3s;
    server {
        listen 127.0.0.1:@PORT@;
        http2 on;
        location = /health { content_by_lua_file @ROOT@/tests/openresty/health.lua; }
        location / { content_by_lua_file @ROOT@/tests/openresty/handler.lua; }
    }
}
